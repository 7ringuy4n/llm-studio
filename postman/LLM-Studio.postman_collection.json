        {
          "name": "Chat Completion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\"role\": \"system\", \"content\": \"Answer concisely.\"},\n    {\"role\": \"user\", \"content\": \"Reply with exactly: LLM Studio is ready\"}\n  ],\n  \"max_tokens\": 32,\n  \"temperature\": 0,\n  \"stream\": false\n}"
            },
            "url": "{{baseUrl}}/v1/chat/completions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('OpenAI response shape is valid', () => { const b = pm.response.json(); pm.expect(b.object).to.eql('chat.completion'); pm.expect(b.choices[0].message.role).to.eql('assistant'); pm.expect(b.usage.total_tokens).to.be.a('number'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Streaming Chat Completion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"Say hello in one short sentence.\"}],\n  \"max_tokens\": 24,\n  \"temperature\": 0,\n  \"stream\": true\n}"
            },
            "url": "{{baseUrl}}/v1/chat/completions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('SSE stream terminates', () => pm.expect(pm.response.text()).to.include('data: [DONE]'));"
                ]
              }
            }
          ]
        }
      ]
