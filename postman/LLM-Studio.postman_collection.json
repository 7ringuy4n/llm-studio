        {
          "name": "Concurrency",
          "item": [
            {
              "name": "Concurrent Batch (3 by default)",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const requested = Number(pm.environment.get('concurrentRequests') || 3);",
                      "const count = Math.max(2, Math.min(Number.isFinite(requested) ? requested : 3, 4));",
                      "const baseUrl = pm.environment.get('baseUrl');",
                      "const model = pm.environment.get('model');",
                      "const token = pm.environment.get('apiKey');",
                      "if (!token) { throw new Error('Set apiKey in the selected environment first'); }",
                      "const started = Date.now();",
                      "const results = [];",
                      "let completed = 0;",
                      "pm.variables.set('concurrentCount', String(count));",
                      "for (let index = 0; index < count; index += 1) {",
                      "  pm.sendRequest({",
                      "    url: `${baseUrl}/v1/chat/completions`,",
                      "    method: 'POST',",
                      "    header: {",
                      "      'Authorization': `Bearer ${token}`,",
                      "      'Content-Type': 'application/json',",
                      "      'X-Request-ID': `postman-concurrent-${started}-${index + 1}`",
                      "    },",
                      "    body: { mode: 'raw', raw: JSON.stringify({",
                      "      model,",
                      "      messages: [{ role: 'user', content: `Worker ${index + 1}: explain split tunneling in one sentence.` }],",
                      "      max_tokens: 40, temperature: 0, stream: false",
                      "    }) }",
                      "  }, (error, response) => {",
                      "    results[index] = {",
                      "      worker: index + 1,",
                      "      status: response ? response.code : 0,",
                      "      requestId: response ? (response.headers.get('X-Request-ID') || '') : '',",
                      "      error: error ? error.message : '',",
                      "      durationMs: Date.now() - started",
                      "    };",
                      "    completed += 1;",
                      "    if (completed === count) {",
                      "      const serialized = JSON.stringify(results);",
                      "      pm.variables.set('concurrentResults', serialized);",
                      "      pm.environment.set('lastConcurrentResults', serialized);",
                      "      console.log('Concurrent batch results', results);",
                      "    }",
                      "  });",
                      "}"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Coordinator health request succeeds', () => pm.response.to.have.status(200));",
                      "const results = JSON.parse(pm.variables.get('concurrentResults') || '[]');",
                      "const count = Number(pm.variables.get('concurrentCount'));",
                      "const limit = Number(pm.environment.get('maxConcurrentRequests') || 1);",
                      "pm.test('Every concurrent response is captured', () => pm.expect(results).to.have.length(count));",
                      "pm.test('Only success or busy responses occur', () => pm.expect(results.every(r => [200, 429].includes(r.status))).to.eql(true));",
                      "pm.test('Configured generation slots succeed', () => pm.expect(results.filter(r => r.status === 200)).to.have.length(Math.min(limit, count)));",
                      "pm.test('Excess concurrent calls are rejected as busy', () => pm.expect(results.filter(r => r.status === 429)).to.have.length(Math.max(0, count - limit)));"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "GET",
                "url": "{{baseUrl}}/health",
                "description": "The pre-request script launches 2-4 chat completions concurrently. The visible GET coordinates the run and reports assertions."
              }
            }
          ]
        },
        {
          "name": "Client-managed Memory",
          "item": [
            {
              "name": "Memory 1 - Start Conversation",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Remember facts supplied in this conversation and answer follow-up questions concisely.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Remember these project facts: codename Kestrel, status color amber, and target number 42. Confirm briefly.\"\n    }\n  ],\n  \"max_tokens\": 80,\n  \"temperature\": 0,\n  \"stream\": false\n}"
                },
                "url": "{{baseUrl}}/v1/chat/completions",
                "description": "Starts a conversation and stores both messages plus the assistant reply in conversationHistory."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                      "const memoryStartRequest = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                      "const memoryStartResponse = pm.response.json();",
                      "const assistant = memoryStartResponse.choices[0].message;",
                      "pm.environment.set('conversationHistory', JSON.stringify([...memoryStartRequest.messages, assistant]));",
                      "pm.environment.set('lastAssistantReply', assistant.content);",
                      "pm.environment.set('lastRequestId', pm.response.headers.get('X-Request-ID') || '');",
                      "pm.test('Conversation history now has three messages', () => pm.expect(JSON.parse(pm.environment.get('conversationHistory'))).to.have.length(3));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Memory 2 - Recall with History",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "let history;",
                      "try { history = JSON.parse(pm.environment.get('conversationHistory') || '[]'); } catch (error) { throw new Error('conversationHistory is invalid JSON'); }",
                      "if (!Array.isArray(history) || history.length < 3) { throw new Error('Run Memory 1 - Start Conversation first'); }",
                      "const question = 'What were the codename, status color, and target number?';",
                      "const payload = {",
                      "  model: pm.environment.get('model'),",
                      "  messages: [...history, { role: 'user', content: question }],",
                      "  max_tokens: 100, temperature: 0, stream: false",
                      "};",
                      "pm.variables.set('memoryQuestion', question);",
                      "pm.variables.set('memoryRequestBody', JSON.stringify(payload));"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                      "const sent = JSON.parse(pm.variables.get('memoryRequestBody'));",
                      "const assistant = pm.response.json().choices[0].message;",
                      "pm.test('Earlier turns were resent', () => pm.expect(sent.messages.length).to.be.above(3));",
                      "pm.test('Recall reply is non-empty', () => pm.expect(assistant.content).to.be.a('string').and.not.empty);",
                      "pm.environment.set('conversationHistory', JSON.stringify([...sent.messages, assistant]));",
                      "pm.environment.set('lastAssistantReply', assistant.content);",
                      "pm.environment.set('lastRequestId', pm.response.headers.get('X-Request-ID') || '');"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{{memoryRequestBody}}"
                },
                "url": "{{baseUrl}}/v1/chat/completions",
                "description": "Replays conversationHistory, adds a follow-up, and stores the completed turn. The server itself remains stateless."
              }
            },
            {
              "name": "Memory 3 - Clear Client Memory",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.environment.set('conversationHistory', '[]');",
                      "pm.environment.unset('lastAssistantReply');",
                      "pm.environment.unset('lastRequestId');"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Coordinator health request succeeds', () => pm.response.to.have.status(200));",
                      "pm.test('Client memory is empty', () => pm.expect(pm.environment.get('conversationHistory')).to.eql('[]'));"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "GET",
                "url": "{{baseUrl}}/health",
                "description": "Clears only Postman environment history; it does not call a server-side memory endpoint."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Security and validation",
      "item": [
        {
          "name": "Reject Missing API Key",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/v1/models"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Unknown Model",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"unknown/model\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"Hello\"}],\n  \"max_tokens\": 8\n}"
            },
            "url": "{{baseUrl}}/v1/chat/completions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Excessive max_tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"Hello\"}],\n  \"max_tokens\": 999999\n}"
            },
            "url": "{{baseUrl}}/v1/chat/completions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Remote Image URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"image_url\",\n          \"image_url\": {\n            \"url\": \"https://example.com/image.png\"\n          }\n        },\n        {\n          \"type\": \"text\",\n          \"text\": \"Describe this image.\"\n        }\n      ]\n    }\n  ],\n  \"max_tokens\": 32\n}"
            },
            "url": "{{baseUrl}}/v1/chat/completions",
            "description": "Remote media fetching is rejected to prevent SSRF. Use embedded PNG, JPEG, or WebP data URLs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
