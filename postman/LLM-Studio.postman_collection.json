    {
      "name": "Advanced LLM Examples",
      "description": "Complex prompting, reasoning, natural communication, multimodal image analysis, concurrency behavior, and explicit client-managed memory.",
      "item": [
        {
          "name": "Complex Structured Prompt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "postman-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a senior reliability engineer. Analyze evidence carefully, distinguish facts from assumptions, and return practical actions. Do not invent missing telemetry.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"A checkout API had latency rise from 180 ms to 4.2 s after a deployment. CPU stayed below 45%, memory rose from 55% to 82%, database connections reached 98%, and rolling back the app did not immediately recover latency. Produce: (1) a ranked hypothesis table with evidence for and against each cause, (2) a 15-minute mitigation plan, (3) five verification commands or queries, and (4) longer-term prevention. Mark every assumption explicitly.\"\n    }\n  ],\n  \"max_tokens\": 320,\n  \"temperature\": 0.2,\n  \"top_p\": 0.9,\n  \"stream\": false\n}"
            },
            "url": "{{baseUrl}}/v1/chat/completions",
            "description": "Multi-constraint incident-analysis prompt. Saves the reply and trace ID in the selected environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Complex reply is non-empty', () => pm.expect(body.choices[0].message.content).to.be.a('string').and.not.empty);",
                  "pm.environment.set('lastRequestId', pm.response.headers.get('X-Request-ID') || '');",
                  "pm.environment.set('lastAssistantReply', body.choices[0].message.content);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reasoning Mode - Qwen3.5 Thinking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "postman-reasoning-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Reason carefully, verify the comparison, and finish with a concise final answer.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Which number is larger: 9.11 or 9.9? Explain why.\"\n    }\n  ],\n  \"max_tokens\": 512,\n  \"temperature\": 1.0,\n  \"top_p\": 0.95,\n  \"stream\": false,\n  \"enable_thinking\": true,\n  \"top_k\": 20,\n  \"min_p\": 0.0,\n  \"repetition_penalty\": 1.0,\n  \"seed\": 42\n}"
            },
            "url": "{{baseUrl}}/v1/chat/completions",
            "description": "Enables Qwen3.5 thinking with enable_thinking=true. Thinking shares max_tokens with the final answer and can be slow on CPU."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const reasoningResult = pm.response.json();",
                  "const reasoningText = reasoningResult.choices[0].message.content;",
                  "pm.test('Reasoning reply is non-empty', () => pm.expect(reasoningText).to.be.a('string').and.not.empty);",
                  "pm.environment.set('lastAssistantReply', reasoningText);",
                  "pm.environment.set('lastRequestId', pm.response.headers.get('X-Request-ID') || '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Natural Communication",
          "description": "A reusable communication-style system prompt plus a contextual follow-up. The style is editable in communicationSkillPrompt.",
          "item": [
            {
              "name": "Natural Reply 1 - Helpful Support Response",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const style = pm.environment.get('communicationSkillPrompt');",
                      "if (!style) { throw new Error('communicationSkillPrompt is empty'); }",
                      "const payload = {",
                      "  model: pm.environment.get('model'),",
                      "  messages: [",
                      "    { role: 'system', content: style },",
                      "    { role: 'user', content: 'A customer says: I uploaded the same report three times, but it still does not appear. Write a helpful response. We know processing is delayed by about 15 minutes; no data was lost. Give one immediate action and one fallback.' }",
                      "  ],",
                      "  max_tokens: 180, temperature: 0.4, top_p: 0.9, stream: false",
                      "};",
                      "pm.variables.set('naturalRequestBody', JSON.stringify(payload));"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                      "const sent = JSON.parse(pm.variables.get('naturalRequestBody'));",
                      "const assistant = pm.response.json().choices[0].message;",
                      "pm.test('Natural reply is non-empty', () => pm.expect(assistant.content).to.be.a('string').and.not.empty);",
                      "pm.environment.set('communicationHistory', JSON.stringify([...sent.messages, assistant]));",
                      "pm.environment.set('lastAssistantReply', assistant.content);",
                      "pm.environment.set('lastRequestId', pm.response.headers.get('X-Request-ID') || '');"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{{naturalRequestBody}}"
                },
                "url": "{{baseUrl}}/v1/chat/completions",
                "description": "Uses communicationSkillPrompt as a reusable natural-response skill and saves the complete exchange for the follow-up."
              }
            },
            {
              "name": "Natural Reply 2 - Contextual Follow-up",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "let history;",
                      "try { history = JSON.parse(pm.environment.get('communicationHistory') || '[]'); } catch (error) { throw new Error('communicationHistory is invalid JSON'); }",
                      "if (!Array.isArray(history) || history.length < 3) { throw new Error('Run Natural Reply 1 - Helpful Support Response first'); }",
                      "const followUp = 'Make the response slightly warmer and shorter, while retaining the delay, no-data-loss, immediate action, and fallback facts.';",
                      "const payload = {",
                      "  model: pm.environment.get('model'),",
                      "  messages: [...history, { role: 'user', content: followUp }],",
                      "  max_tokens: 140, temperature: 0.35, top_p: 0.9, stream: false",
                      "};",
                      "pm.variables.set('naturalFollowUpBody', JSON.stringify(payload));"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                      "const sent = JSON.parse(pm.variables.get('naturalFollowUpBody'));",
                      "const assistant = pm.response.json().choices[0].message;",
                      "pm.test('Communication context was replayed', () => pm.expect(sent.messages.length).to.be.above(3));",
                      "pm.test('Follow-up reply is non-empty', () => pm.expect(assistant.content).to.be.a('string').and.not.empty);",
                      "pm.environment.set('communicationHistory', JSON.stringify([...sent.messages, assistant]));",
                      "pm.environment.set('lastAssistantReply', assistant.content);",
                      "pm.environment.set('lastRequestId', pm.response.headers.get('X-Request-ID') || '');"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{{naturalFollowUpBody}}"
                },
                "url": "{{baseUrl}}/v1/chat/completions",
                "description": "Replays the natural-communication exchange and asks for a shorter, warmer revision without losing factual constraints."
              }
            }
          ]
        },
