# Copy to .env only if you are configuring manually. scripts/setup.sh creates it.
# Use loopback for local/SSH-tunnel access, or the VPS's explicit OpenVPN IP.
LLM_STUDIO_BIND_ADDRESS=127.0.0.1
LLM_STUDIO_PORT=18080
LLM_STUDIO_DATA_DIR=/opt/data/llm-studio
LLM_STUDIO_API_KEY=replace-with-at-least-32-random-characters
LLM_STUDIO_APP_UID=10001
LLM_STUDIO_APP_GID=10001

MODEL_ID=Qwen/Qwen3.5-0.8B
MODEL_REVISION=main
MODEL_MAX_INPUT_TOKENS=2048
MODEL_MAX_NEW_TOKENS=512
MODEL_LOAD_ON_START=false
LLM_STUDIO_CPU_THREADS=3
LLM_STUDIO_REQUEST_TIMEOUT_SECONDS=180
LLM_STUDIO_MAX_CONCURRENT_REQUESTS=1
LLM_STUDIO_RATE_LIMIT_PER_MINUTE=30
