# Copy to .env only if you are configuring manually. scripts/setup.sh creates it.
# Use loopback for local/SSH-tunnel access, or the VPS's explicit OpenVPN IP.
LLM_STUDIO_BIND_ADDRESS=127.0.0.1
LLM_STUDIO_PORT=18080
# local = loopback/private/VPN HTTP; internet = public HTTPS on ports 80/443.
LLM_STUDIO_TRAEFIK_MODE=local
LLM_STUDIO_INTERNET_BIND_ADDRESS=0.0.0.0
LLM_STUDIO_PUBLIC_DOMAIN=llm.example.com
LLM_STUDIO_ACME_EMAIL=admin@example.com
LLM_STUDIO_HTTP_PORT=80
LLM_STUDIO_HTTPS_PORT=443
LLM_STUDIO_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
LLM_STUDIO_DATA_DIR=/opt/data/llm-studio
LLM_STUDIO_API_KEY=replace-with-at-least-32-random-characters
LLM_STUDIO_APP_UID=10001
LLM_STUDIO_APP_GID=10001

MODEL_ID=Qwen/Qwen3.5-0.8B
MODEL_BACKEND=multimodal
MODEL_DTYPE=auto
MODEL_REVISION=main
MODEL_ALLOWED_MODELS=Qwen/Qwen3.5-0.8B,Qwen/Qwen3.5-2B
MODEL_PRELOAD_MODELS=qwen35-0.8b,qwen35-2b
MODEL_IDLE_UNLOAD_SECONDS=3600
MODEL_GGUF_CONTEXT_TOKENS=32768
MODEL_KV_CACHE_BYTES=2147483648
MODEL_CONTEXT_TOKENS=262144
MODEL_MAX_INPUT_TOKENS=262144
MODEL_MAX_NEW_TOKENS=2048
MODEL_MIN_NEW_TOKENS=16
MODEL_LOAD_ON_START=false
LLM_STUDIO_CPU_THREADS=3
LLM_STUDIO_REQUEST_TIMEOUT_SECONDS=900
LLM_STUDIO_MAX_CONCURRENT_REQUESTS=1
LLM_STUDIO_QUEUE_TIMEOUT_SECONDS=900
LLM_STUDIO_REQUEST_TRACE_LOGGING=true
LLM_STUDIO_REQUEST_TRACE_MAX_CONTENT_CHARS=32768

# Optional local/private observability UI. It is never exposed by public Traefik.
LLM_STUDIO_OBSERVABILITY_ENABLED=false
LLM_STUDIO_OBSERVABILITY_BIND_ADDRESS=127.0.0.1
LLM_STUDIO_OBSERVABILITY_PORT=15080
LLM_STUDIO_OBSERVABILITY_RETENTION_DAYS=30
LLM_STUDIO_OPENOBSERVE_EMAIL=admin@llm-studio.local
LLM_STUDIO_OPENOBSERVE_PASSWORD=replace-with-a-strong-uppercase-lowercase-digit-special-password
LLM_STUDIO_OPENOBSERVE_AUTH=replace-with-base64-email-colon-password
LLM_STUDIO_OPENOBSERVE_IMAGE=public.ecr.aws/zinclabs/openobserve:v1.0.3
LLM_STUDIO_OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.153.0
